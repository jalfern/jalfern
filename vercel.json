{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/retrogames",
      "destination": "https://retrogames-psi.vercel.app/retrogames"
    },
    {
      "source": "/retrogames/",
      "destination": "https://retrogames-psi.vercel.app/retrogames/"
    },
    {
      "source": "/retrogames/:path*",
      "destination": "https://retrogames-psi.vercel.app/retrogames/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/thinkfish",
      "destination": "/thinkfish/",
      "permanent": false
    },
    {
      "source": "/plaicraft",
      "destination": "/plaicraft/",
      "permanent": false
    },
    {
      "source": "/plaicraft/map",
      "destination": "/plaicraft/map/",
      "permanent": false
    },
    {
      "source": "/plaicraft/deck",
      "destination": "/plaicraft/deck/",
      "permanent": false
    },
    {
      "source": "/plaicraft/pitch",
      "destination": "/plaicraft/pitch/",
      "permanent": false
    }
  ]
}
